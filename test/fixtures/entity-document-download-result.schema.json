{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "documentId": { "type": "string", "maxLength": 4096 },
    "title": { "type": "string", "maxLength": 4096 },
    "type": { "type": "string", "maxLength": 4096 },
    "download": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https?://[^\\s]+$"
        },
        "method": { "type": "string", "const": "GET" },
        "mimeType": { "type": "string", "const": "application/pdf" },
        "expiresAt": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "singleUse": { "type": "boolean", "const": true }
      },
      "required": ["url", "method", "mimeType", "expiresAt", "singleUse"],
      "additionalProperties": false
    },
    "refreshAction": { "type": "string", "const": "download-entity-document" }
  },
  "required": ["documentId", "title", "type", "download", "refreshAction"],
  "additionalProperties": false
}
