# Complete standard Exact-EVM rail. This template is for the Base Sepolia
# deployment; replace every secret/artifact placeholder before release.
NODE_ENV=production
CHAIN_MODE=live
CHAIN_ID=84532
PORT=3000
PUBLIC_URL=https://sandbox-gateway.daski.io
TRUST_PROXY=1
MCP_ENABLED=true
MCP_PATH=/mcp

DATABASE_URL=postgresql://runtime-role:password@host:5432/daski_gateway
MIGRATION_DATABASE_URL=postgresql://migration-role:password@host:5432/daski_gateway
# One-shot cutover CLI inputs; these are not gateway runtime configuration.
STANDARD_RAIL_CUTOVER_ARCHIVE_PATH=/secure/path/pre-standard-cutover.dump
STANDARD_RAIL_CUTOVER_ARCHIVE_SHA256=0xREPLACE_WITH_64_HEX_ARCHIVE_SHA256

# Circle Base Sepolia USDC reviewed EIP-712 domain.
USDC_ADDRESS=0x036cbd53842c5426634e7929541ec2318f3dcf7e
USDC_DECIMALS=6
USDC_NAME=USDC
USDC_VERSION=2
USDC_DOMAIN_SEPARATOR=0x71f17a3b2ff373b803d70a5a07c046c1a2bc8e89c09ef722fcb047abe94c9818

# Official facilitator credentials. Never put real values in this file.
CDP_API_KEY_ID=replace-in-platform
CDP_API_KEY_SECRET=replace-in-platform
# CDP_FACILITATOR_BASE_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Signed release/artifact domain.
STANDARD_RAIL_ENVIRONMENT=testnet
STANDARD_RAIL_GATEWAY_AUDIENCE=https://sandbox-gateway.daski.io
STANDARD_RAIL_TRUSTED_SIGNERS_JSON={"replace-key-id":"0x0000000000000000000000000000000000000001"}
STANDARD_RAIL_MANIFEST_JSON={"replace":"with reviewed signed manifest"}
# Supplied automatically by Railway. Local release measurement must set the
# exact commit being built; startup rejects a mismatch with the signed manifest.
RAILWAY_GIT_COMMIT_SHA=0000000000000000000000000000000000000000
# Railway injects these workload identifiers. Local integrity checks need
# explicit non-secret placeholders that match FacilitatorCredentialBindingV1.
RAILWAY_PROJECT_ID=replace-railway-project-id
RAILWAY_ENVIRONMENT_ID=replace-railway-environment-id
RAILWAY_SERVICE_ID=replace-railway-service-id

# Two independent RPC hosts. Both must support receipts, historical code,
# events, and debug_traceTransaction.
STANDARD_RAIL_EVIDENCE_RPC_URLS=https://replace-independent-rpc-a,https://replace-independent-rpc-b
STANDARD_RAIL_FINALITY_CONFIRMATIONS=12
# Independently queried immediately before settlement and refunds.
SANCTIONS_ORACLE_ADDRESS=0x0000000000000000000000000000000000000003
SANCTIONS_ORACLE_MODE=production

# Generate six unrelated keys; every placeholder below must be replaced with a
# different 64-hex value. The refund executor owns the prefunded reserve.
STANDARD_RAIL_QUOTE_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_QUOTE_KEY
STANDARD_RAIL_DISPATCH_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_DISPATCH_KEY
STANDARD_RAIL_RECEIPT_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_RECEIPT_KEY
STANDARD_RAIL_LIFECYCLE_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_LIFECYCLE_KEY
STANDARD_RAIL_RELEASE_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_RELEASE_KEY
STANDARD_RAIL_REFUND_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_REFUND_KEY
STANDARD_RAIL_REFUND_EXECUTION_RESERVE_ADDRESS=0x0000000000000000000000000000000000000002
STANDARD_RAIL_REFUND_MAX_TRANSACTION_AMOUNT_ATOMIC=100000000
STANDARD_RAIL_REFUND_MAX_RESERVED_AMOUNT_ATOMIC=1000000000
STANDARD_RAIL_REFUND_MAX_NETWORK_FEE_WEI=5000000000000000
STANDARD_RAIL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_WITHOUT_0X

# Private S3-compatible attachment storage.
STANDARD_RAIL_OBJECT_STORE_ENDPOINT=https://replace-object-store-endpoint
STANDARD_RAIL_OBJECT_STORE_REGION=auto
STANDARD_RAIL_OBJECT_STORE_BUCKET=daski-standard-rail-testnet
STANDARD_RAIL_OBJECT_STORE_ACCESS_KEY_ID=replace-in-platform
STANDARD_RAIL_OBJECT_STORE_SECRET_ACCESS_KEY=replace-in-platform
STANDARD_RAIL_UPLOAD_ALLOWED_MEDIA_TYPES=application/pdf,image/png,image/jpeg,text/plain
STANDARD_RAIL_UPLOAD_TTL_SECONDS=900
STANDARD_RAIL_UPLOAD_MAX_OBJECTS=5
STANDARD_RAIL_UPLOAD_MAX_OBJECT_BYTES=400000
STANDARD_RAIL_UPLOAD_MAX_AGGREGATE_BYTES=600000

# Durable recovery and outbound request timing. Signed listing deadlines are
# authoritative and must be longer than these transport budgets.
STANDARD_RAIL_FACILITATOR_TIMEOUT_MS=30000
STANDARD_RAIL_DISPATCH_TIMEOUT_MS=90000
STANDARD_RAIL_LEASE_SECONDS=45
STANDARD_RAIL_RECOVERY_INTERVAL_MS=10000
SHUTDOWN_GRACE_MS=25000

# Aggregate abuse limits. Adjust only with capacity review.
RPC_READ_MAX_PER_MINUTE=300
STATE_CHANGE_GLOBAL_MAX_PER_MINUTE=300
MCP_GLOBAL_MAX_PER_MINUTE=300
PUBLIC_READ_MAX_PER_MINUTE=120
PUBLIC_READ_GLOBAL_MAX_PER_MINUTE=1200
