# Complete standard Exact-EVM rail. This template is for the Base Sepolia
# deployment; replace every secret/artifact placeholder before release.
NODE_ENV=production
CHAIN_MODE=live
CHAIN_ID=84532
PORT=3000
PUBLIC_URL=https://sandbox-gateway.daski.io
TRUST_PROXY=1
MCP_ENABLED=true
MCP_PATH=/mcp

DATABASE_URL=postgresql://runtime-role:password@host:5432/daski_gateway
MIGRATION_DATABASE_URL=postgresql://migration-role:password@host:5432/daski_gateway
# One-shot cutover CLI inputs; these are not gateway runtime configuration.
STANDARD_RAIL_CUTOVER_ARCHIVE_PATH=/secure/path/pre-standard-cutover.dump
STANDARD_RAIL_CUTOVER_ARCHIVE_SHA256=0xREPLACE_WITH_64_HEX_ARCHIVE_SHA256

# Circle Base Sepolia USDC reviewed EIP-712 domain.
USDC_ADDRESS=0x036cbd53842c5426634e7929541ec2318f3dcf7e
USDC_DECIMALS=6
USDC_NAME=USDC
USDC_VERSION=2
USDC_DOMAIN_SEPARATOR=0x71f17a3b2ff373b803d70a5a07c046c1a2bc8e89c09ef722fcb047abe94c9818

# Independent identity, provider catalog, validation, and fresh standard-order
# reputation contracts. These are not payment contracts.
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
AGENT_INDEX_ADDRESS=0xA9b7ff6158E51581F253a8234EAC79411FB0e1cf
PROVIDER_REGISTRY_ADDRESS=0xba7d08a4851975b3e80550b9aa4aA6092dCBC909
SERVICE_REGISTRY_ADDRESS=0x79114da4DA6FbEcF1897950BB051b55c8d839840
DASKI_VALIDATION_REGISTRY_ADDRESS=0xC3EA96dAaF863707573a342138394d51e336FBBC
REPUTATION_STORAGE_ADDRESS=0x2CA0B71a5D6C0499ec14838A8bD809351E535815
REPUTATION_DEPLOYMENT_BLOCK=replace-with-reviewed-proxy-deployment-block
EAS_ADDRESS=0x4200000000000000000000000000000000000021
REPUTATION_OUTCOME_SCHEMA_UID=0xREPLACE_WITH_64_HEX_OUTCOME_SCHEMA_UID
REPUTATION_CONFIRMATION_SCHEMA_UID=0xREPLACE_WITH_64_HEX_CONFIRMATION_SCHEMA_UID
REPUTATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000004

# Official facilitator credentials. Never put real values in this file.
CDP_API_KEY_ID=replace-in-platform
CDP_API_KEY_SECRET=replace-in-platform
# CDP_FACILITATOR_BASE_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Signed release/artifact domain.
STANDARD_RAIL_ENVIRONMENT=testnet
STANDARD_RAIL_GATEWAY_AUDIENCE=https://sandbox-gateway.daski.io
STANDARD_RAIL_TRUSTED_SIGNERS_JSON={"replace-key-id":"0x0000000000000000000000000000000000000001"}
STANDARD_RAIL_MANIFEST_JSON={"replace":"with reviewed signed manifest"}
MARKETPLACE_COMMISSION_BPS=500
MARKETPLACE_LAUNCH_OUTCOME_IDS_JSON=["register-domain","create-agent-mailbox","form-wyoming-llc"]
# Exact reviewed hashes for every launch listing. Each content entry has only:
# serviceId, deliveryCommitmentHash, termsHash, requestSchemaHash,
# responseSchemaHash, and fulfillmentObligationHash. Jurisdiction entries are
# objects keyed by the exact jurisdiction identifiers published by the listing.
MARKETPLACE_REVIEWED_CONTENT_HASHES_JSON={"register-domain":{"serviceId":"0xREPLACE","deliveryCommitmentHash":"0xREPLACE","termsHash":"0xREPLACE","requestSchemaHash":"0xREPLACE","responseSchemaHash":"0xREPLACE","fulfillmentObligationHash":"0xREPLACE"},"create-agent-mailbox":{"serviceId":"0xREPLACE","deliveryCommitmentHash":"0xREPLACE","termsHash":"0xREPLACE","requestSchemaHash":"0xREPLACE","responseSchemaHash":"0xREPLACE","fulfillmentObligationHash":"0xREPLACE"},"form-wyoming-llc":{"serviceId":"0xREPLACE","deliveryCommitmentHash":"0xREPLACE","termsHash":"0xREPLACE","requestSchemaHash":"0xREPLACE","responseSchemaHash":"0xREPLACE","fulfillmentObligationHash":"0xREPLACE"}}
MARKETPLACE_APPROVED_JURISDICTION_OBLIGATION_HASHES_JSON={"register-domain":{"global":"0xREPLACE"},"create-agent-mailbox":{"global":"0xREPLACE"},"form-wyoming-llc":{"US-WY":"0xREPLACE"}}
# Supplied automatically by Railway. Local release measurement must set the
# exact commit being built; startup rejects a mismatch with the signed manifest.
RAILWAY_GIT_COMMIT_SHA=0000000000000000000000000000000000000000
# Railway injects these workload identifiers. Local integrity checks need
# explicit non-secret placeholders that match FacilitatorCredentialBindingV1.
RAILWAY_PROJECT_ID=replace-railway-project-id
RAILWAY_ENVIRONMENT_ID=replace-railway-environment-id
RAILWAY_SERVICE_ID=replace-railway-service-id

# Two independent RPC hosts. Both must support receipts, historical code,
# events, and debug_traceTransaction.
STANDARD_RAIL_EVIDENCE_RPC_URLS=https://replace-independent-rpc-a,https://replace-independent-rpc-b
STANDARD_RAIL_FINALITY_CONFIRMATIONS=12
# Independently queried immediately before settlement and refunds.
SANCTIONS_ORACLE_ADDRESS=0x0000000000000000000000000000000000000003
SANCTIONS_ORACLE_MODE=production

# Generate six unrelated keys; every placeholder below must be replaced with a
# different 64-hex value. The refund executor owns the prefunded reserve.
STANDARD_RAIL_QUOTE_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_QUOTE_KEY
STANDARD_RAIL_DISPATCH_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_DISPATCH_KEY
STANDARD_RAIL_RECEIPT_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_RECEIPT_KEY
STANDARD_RAIL_LIFECYCLE_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_LIFECYCLE_KEY
STANDARD_RAIL_RELEASE_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_RELEASE_KEY
STANDARD_RAIL_REFUND_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_REFUND_KEY
REPUTATION_ORDER_SIGNER_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_REPUTATION_ORDER_KEY
REPUTATION_RELAYER_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_REPUTATION_RELAYER_KEY
MIRROR_CLIENT_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_MIRROR_CLIENT_KEY
ORDER_EVENT_SIGNING_PRIVATE_KEY=0xREPLACE_WITH_DISTINCT_ORDER_EVENT_KEY
ORDER_EVENT_SIGNING_KEY_ID=replace-order-event-key-id
# During rotation, publish old public addresses until every signed-event retry expires.
# Exact entries: {"keyId","address","notBefore","notAfter"}; timestamps are Unix seconds.
ORDER_EVENT_PREVIOUS_KEYS_JSON=[]
STANDARD_RAIL_REFUND_EXECUTION_RESERVE_ADDRESS=0x0000000000000000000000000000000000000002
STANDARD_RAIL_REFUND_MAX_TRANSACTION_AMOUNT_ATOMIC=100000000
STANDARD_RAIL_REFUND_MAX_RESERVED_AMOUNT_ATOMIC=1000000000
STANDARD_RAIL_REFUND_MAX_NETWORK_FEE_WEI=5000000000000000
STANDARD_RAIL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_WITHOUT_0X
STANDARD_RAIL_CURSOR_KEYS_JSON={"activeKeyId":"primary","keys":{"primary":"REPLACE_WITH_64_HEX_WITHOUT_0X"}}

# Reputation registration, confirmation, refund, and mirror transaction policy.
REPUTATION_PERMIT_TTL_SECONDS=900
REPUTATION_RETRY_DELAYS_SECONDS=[5,60,3000,30000]
REPUTATION_REGISTER_GAS_LIMIT=replace-with-reviewed-measurement
REPUTATION_CONFIRMATION_GAS_LIMIT=replace-with-reviewed-measurement
REPUTATION_REFUND_GAS_LIMIT=replace-with-reviewed-measurement
REPUTATION_MAX_FEE_PER_GAS_WEI=replace-with-reviewed-measurement
REPUTATION_MAX_PRIORITY_FEE_PER_GAS_WEI=replace-with-reviewed-measurement
REPUTATION_MINIMUM_RESERVE_WEI=replace-with-reviewed-measurement
MIRROR_MAX_TRANSACTIONS_PER_ORDER=5
MIRROR_MAX_TRANSACTIONS_PER_UTC_DAY=2500
MIRROR_GIVE_GAS_LIMIT=replace-with-reviewed-measurement
MIRROR_REVOKE_GAS_LIMIT=replace-with-reviewed-measurement
MIRROR_MAX_FEE_PER_GAS_WEI=replace-with-reviewed-measurement
MIRROR_MAX_PRIORITY_FEE_PER_GAS_WEI=replace-with-reviewed-measurement
MIRROR_MINIMUM_RESERVE_WEI=replace-with-reviewed-measurement
CONFIRMATION_DEADLINE_SECONDS=300
CONFIRMATION_MAX_PER_ORDER=3
CONFIRMATION_MAX_PER_PAYER_PER_UTC_DAY=20
CONFIRMATION_MAX_GLOBAL_PER_UTC_DAY=500

# Signed order notifications and operator-only reconciliation.
ORDER_EVENT_RETRY_DELAYS_SECONDS=[5,60,3000,30000]
ORDER_EVENT_VERIFICATION_TIMEOUT_MS=5000
ORDER_EVENT_VERIFICATION_TTL_SECONDS=300
ORDER_EVENT_MAX_RESPONSE_BYTES=65536
ORDER_EVENT_MAX_PENDING_PER_PAYER=10
ORDER_EVENT_MAX_PENDING_GLOBAL=1000
STANDARD_RAIL_ADMIN_BEARER_TOKEN=replace-with-high-entropy-admin-token
STANDARD_RAIL_ADMIN_CSRF_TOKEN=replace-with-independent-high-entropy-csrf-token

# Private S3-compatible attachment storage.
STANDARD_RAIL_OBJECT_STORE_ENDPOINT=https://replace-object-store-endpoint
STANDARD_RAIL_OBJECT_STORE_REGION=auto
STANDARD_RAIL_OBJECT_STORE_BUCKET=daski-standard-rail-testnet
STANDARD_RAIL_OBJECT_STORE_ACCESS_KEY_ID=replace-in-platform
STANDARD_RAIL_OBJECT_STORE_SECRET_ACCESS_KEY=replace-in-platform
STANDARD_RAIL_UPLOAD_ALLOWED_MEDIA_TYPES=application/pdf,image/png,image/jpeg,text/plain
STANDARD_RAIL_UPLOAD_TTL_SECONDS=900
STANDARD_RAIL_UPLOAD_MAX_OBJECTS=5
STANDARD_RAIL_UPLOAD_MAX_OBJECT_BYTES=400000
STANDARD_RAIL_UPLOAD_MAX_AGGREGATE_BYTES=600000

# Durable recovery and outbound request timing. Signed listing deadlines are
# authoritative and must be longer than these transport budgets.
STANDARD_RAIL_FACILITATOR_TIMEOUT_MS=30000
STANDARD_RAIL_DISPATCH_TIMEOUT_MS=90000
STANDARD_RAIL_LEASE_SECONDS=45
STANDARD_RAIL_RECOVERY_INTERVAL_MS=10000
SHUTDOWN_GRACE_MS=25000

# Reviewed wallet, federation, and aggregate abuse limits.
WALLET_CHALLENGES_PER_CLIENT_PER_MINUTE=30
WALLET_CHALLENGES_GLOBAL_PER_MINUTE=300
WALLET_CHALLENGES_OUTSTANDING_PER_CLIENT=20
WALLET_CHALLENGES_OUTSTANDING_GLOBAL=10000
WALLET_PROTECTED_READS_PER_PAYER_PER_MINUTE=30
ASSET_LISTS_PER_PAYER_PER_MINUTE=6
ASSET_STATE_CHANGES_PER_PAYER_PER_MINUTE=10
DESTRUCTIVE_STAGES_PER_PAYER_PER_HOUR=3
FEDERATION_GLOBAL_CONCURRENCY=40
FEDERATION_PER_PROVIDER_CONCURRENCY=4
FEDERATION_MAX_PROVIDERS_PER_REQUEST=20
FEDERATION_PER_PROVIDER_PER_MINUTE=120
FEDERATION_GLOBAL_PER_MINUTE=300
RPC_READ_MAX_PER_MINUTE=300
STATE_CHANGE_GLOBAL_MAX_PER_MINUTE=300
MCP_GLOBAL_MAX_PER_MINUTE=300
PUBLIC_READ_MAX_PER_MINUTE=120
PUBLIC_READ_GLOBAL_MAX_PER_MINUTE=1200
