{
  "name": "daski-gateway",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/migrations && mkdir -p dist/static && cp src/static/SKILL.md dist/static/SKILL.md",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "live-e2e": "tsx scripts/live-e2e.ts",
    "validate-provider-legal": "tsx scripts/validate-provider-legal.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "iso-3166": "4.4.0",
    "pg": "^8.13.0",
    "undici": "^7.0.0",
    "viem": "^2.21.0"
  },
  "overrides": {
    "protobufjs": "^7.5.5"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.48.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
