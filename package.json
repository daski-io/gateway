{
  "name": "daski-gateway",
  "version": "0.20.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.53.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@x402/core": "2.20.0",
    "@x402/extensions": "2.20.0",
    "ajv": "8.20.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "viem": "^2.55.4",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "axios": "^1.18.1",
    "nanoid": "3.3.18",
    "protobufjs": "^7.6.3",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
